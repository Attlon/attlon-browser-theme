{
  "manifest_version": 3,
  "name": "Attlon Workspace & Dynamic Dashboard",
  "short_name": "Attlon",
  "version": "1.5.0",
  "description": "Espacio corporativo de Attlon: fondo dinámico, buscador Copilot, noticias PCI y herramientas de seguridad industrial.",
  "author": "Attlon Industrial Safety",
  "homepage_url": "https://attlon.com/",
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "bookmarks"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://open.er-api.com/*",
    "https://ipwho.is/*",
    "https://freeipapi.com/*",
    "https://news.google.com/*",
    "https://feeds.elpais.com/*",
    "https://www.20minutos.es/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}