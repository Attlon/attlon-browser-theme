{
  "manifest_version": 3,
  "name": "Attlon Workspace & Dynamic Dashboard",
  "short_name": "Attlon Workspace",
  "version": "1.3.0",
  "key": "",
  "description": "Espacio de trabajo corporativo oficial de Attlon. Fondo dinámico de vídeo, modo claro/oscuro, previsión meteorológica interactiva en vivo, accesos directos configurables (PayFit, Cottés, Autodesk Forma, SharePoint) y sincronización de marcadores.",
  "author": "Attlon Industrial Safety",
  "homepage_url": "https://attlon.com/",
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "permissions": [
    "bookmarks"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
