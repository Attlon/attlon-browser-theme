Windows Registry Editor Version 5.00

; ==============================================================================
; POLÍTICA CORPORATIVA ATTLON: MARCADORES ADMINISTRADOS (MANAGED BOOKMARKS)
; Configuración obligatoria para Google Chrome y Microsoft Edge
; Sincroniza los accesos directos oficiales en la barra de favoritos (incluye PayFit)
; ==============================================================================

; --- GOOGLE CHROME ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"ManagedBookmarks"="[{\"toplevel_name\":\"⭐ Attlon Corporativo\"},{\"name\":\"Cottes Admin\",\"url\":\"https://admin.cloudcottes.com/login\"},{\"name\":\"Autodesk Forma\",\"url\":\"https://acc.autodesk.eu/projects\"},{\"name\":\"PayFit\",\"url\":\"https://login.payfit.com/\"},{\"name\":\"Attlon · GitHub\",\"url\":\"https://github.com/attlon\"},{\"name\":\"PERSONAL COTTES 2026.xlsx\",\"url\":\"https://cottesgroup.sharepoint.com/:x:/r/sites/GlobalCotts/_layouts/15/doc2.aspx?action=edit&sourcedoc=%7B40c743a7-bc02-4fba-aad7-eeccbd1fca0b%7D&wdExp=TEAMS-TREATMENT&web=1\"},{\"name\":\"Attlon · LinkedIn\",\"url\":\"https://www.linkedin.com/company/attlon/\"},{\"name\":\"Cottés Group\",\"url\":\"https://www.cottesgroup.com/\"},{\"name\":\"Electro Alavesa\",\"url\":\"https://www.electroalavesa.es/\"},{\"name\":\"SVC Seguridad\",\"url\":\"https://www.svcseguridad.com/\"},{\"name\":\"📚 Normativa & Fuentes PCI\",\"children\":[{\"name\":\"CTE DB-SI Interactivo\",\"url\":\"https://www.codigotecnico.org/DocumentosCTE/SeguridadEnCasoDeIncendio.html\"},{\"name\":\"Guía Técnica RIPCI (RD 513/2017)\",\"url\":\"https://www.boe.es/buscar/act.php?id=BOE-A-2017-6642\"},{\"name\":\"RSCIEI (Seguridad Industrial)\",\"url\":\"https://www.boe.es/buscar/act.php?id=BOE-A-2004-20707\"},{\"name\":\"TECNIFUEGO\",\"url\":\"https://www.tecnifuego.org/\"},{\"name\":\"CEPREVEN\",\"url\":\"https://www.cepreven.com/\"},{\"name\":\"NFPA LiNK\",\"url\":\"https://link.nfpa.org/\"}]}]"

